<Window x:Class="tomat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tomat" 
        Height="150" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False">
    
    <Border x:Name="MainBorder" 
            Background="#CC1E1E1E" 
            CornerRadius="8" 
            Padding="10" 
            Margin="10">
        <StackPanel x:Name="MediaSessionsContainer" Orientation="Vertical" />
    </Border>
</Window>
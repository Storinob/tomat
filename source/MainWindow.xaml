<Window x:Class="tomat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Flyout" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        ShowActivated="False">

    <Border CornerRadius="6" Background="#1E1E1E" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Direction="270"/>
        </Border.Effect>
        <StackPanel x:Name="MediaSessionsContainer" Margin="12,8"/>
    </Border>
</Window>